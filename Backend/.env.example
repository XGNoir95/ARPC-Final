# Copy to Backend/.env for local development. Never commit real credentials.
# Keep this reference file free of passwords, mailbox credentials and API keys.

# Server and database
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/arpc
FRONTEND_URL=http://localhost:5173
# Match the frontend browser origin. Append /# only when using HashRouter.

# Local admin site: run npm run dev:admin in Frontend.
# "local" is permitted only with NODE_ENV=development and loopback requests.
# Production defaults to "disabled" if ADMIN_ACCESS_MODE is omitted.
ADMIN_FRONTEND_URL=http://admin.localhost:5174
ADMIN_ACCESS_MODE=local
# Production: use mode cloudflare, an HTTPS admin origin and values from Access.
ADMIN_ACCESS_ISSUER=
ADMIN_ACCESS_AUDIENCE=

# Optional Google sign-in: Web application OAuth client ID, not a client secret.
GOOGLE_CLIENT_ID=

# Email delivery. For Gmail, SMTP_PASS is an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional public HTTPS emblem URL override. This is the club's public AUST image.
# The built-in default is the same URL. No image file is attached to service emails.
MAIL_LOGO_URL=https://www.aust.edu/storage/files/Te3EO82GEGAdm9ihZ8VGEg1WMi5VHSpjbEw5T0FD.jpg
# Uploaded files stay local; do not commit uploads or database files.
UPLOAD_DIR=./uploads
# Optional: dev:local defaults to ~/.arpc/dev-db (persistent local data).
LOCAL_DB_DIR=
# Used only by npm run admin:create. Remove the password after creating the account.
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Leave blank for the current single-process local setup. Required in production.
REDIS_URL=
REDIS_PREFIX=arpc
# 0 for direct local access; 1 only behind the provided trusted reverse proxy.
TRUST_PROXY=0
SESSION_DAYS=7
SESSION_IDLE_HOURS=12
MAIL_WORKER_ENABLED=true
REQUEST_LOGGING=false
