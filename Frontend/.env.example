# Copy to Frontend/.env.local only when overriding local defaults.
# Every VITE_ value is public in the browser. Keep secrets in Backend/.env.
# Local development defaults; production values are set by the deployment workflow.
VITE_BASE_PATH=/
VITE_GITHUB_PAGES=false
# API base URL. Local Vite proxies /api to http://127.0.0.1:4000 after checking readiness.
# This is a public URL, never a credential.
VITE_API_URL=/api

# For npm run build:admin, set the exact HTTPS origin protected by Access.
# npm run dev:admin defaults to http://admin.localhost:5174.
VITE_ADMIN_ORIGIN=

# Optional HTTPS CDN base for bundled public images and fonts.
# Never use this for private /api/admin or /api/learning assets.
VITE_ASSET_CDN_URL=
